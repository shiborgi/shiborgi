
# --- OpenCode agent provider -------------------------------------------------
# Read on the host and injected only into containers whose group runs
# `provider: opencode`. They select the backend; they do NOT switch the
# provider (`ncl groups config update --provider opencode` does that).
#
# `opencode-go` is OpenCode's own subscription. The gateway holds its key and
# resolves the model alias, so ANTHROPIC_BASE_URL is deliberately left unset
# here — the gateway injects its own, pointing the container back at itself.
# Setting it would send the container straight to the provider with a
# credential of its own, which is the arrangement the gateway exists to avoid.
OPENCODE_PROVIDER=opencode-go
OPENCODE_MODEL=opencode-go/deepseek-v4-flash
OPENCODE_SMALL_MODEL=opencode-go/deepseek-v4-flash
