# Copy to secrets.env and fill in. This file is the ONLY place upstream
# credentials exist; they are never written to .env, never passed to an agent
# container, and never appear in gateway.json.
#
# Referenced by name from gateway.json (`auth.secret`).

# The OpenCode Zen key, for the `zen-go` upstream the default model uses.
# Bearer, not x-api-key: the latter is rejected as "Missing API key".
OPENCODE_ZEN_API_KEY=

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Written by `pnpm exec tsx scripts/google-oauth-connect.ts google-primary`;
# the refresh token line is filled in by that script, never by hand.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_PRIMARY_REFRESH_TOKEN=
